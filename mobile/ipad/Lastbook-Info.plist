<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Picture in Picture and a video's sound keep playing when Lastbook goes to the background, only for playback the person
	     started (the player opens paused). Nothing else runs in the background: the local AI is still freed on background. -->
	<!-- The app's Documents folder shows in Files › On My iPad › Lastbook and in Finder (the library and the AI file go
	     there). INFOPLIST_KEY_UIFileSharingEnabled is not a key Xcode generates, so builds up to 0.4 lacked it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
