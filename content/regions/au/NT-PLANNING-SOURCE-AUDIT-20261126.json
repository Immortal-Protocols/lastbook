    {
      "topic": "NT contact associations",
      "source": "https://securent.nt.gov.au/emergency-contacts",
      "method": "Official page read through web tool;raw acquisition403. Displayed update29April2024.",
      "facts": "000 emergency;131444 police assistance;1800245090 Power and Water;132500 storm assistance;1800246199 road report."
    },
    {
      "topic": "Shelter opening and car-park distinction",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/emergency-planning/emergency-shelters",
      "supporting": "https://securent.nt.gov.au/prepare-for-an-emergency/emergency-planning/animals",
      "facts": "Public shelter opening must be announced. Designated Darwin car-park options allow remaining in vehicles with restrained pets,have limited services,and are not public emergency shelters. An ordinary car park is not established as suitable."
    },
    {
      "topic": "Cyclone home/surge decisions",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/cyclone/prepare-your-home",
      "supporting": "https://securent.nt.gov.au/prepare-for-an-emergency/cyclone/storm-surge",
      "method": "Both official pages read through web tool;raw acquisition403.",
      "facts": "Home suitability and condition require assessment;caravans unsuitable for cyclone shelter;surge can arrive before landfall;wind protection does not establish flood/surge safety."
    },
    {
      "topic": "Cyclone eye and shelter timing",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/cyclone/evacuate-stay",
      "facts": "Temporary calm is not an all-clear;remain sheltered until authorities advise safety;public shelter opening/current instructions govern departure."
    },
    {
      "topic": "Household source supply list",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/emergency-planning/emergency-plans-and-kits",
      "facts": "At least72hours of supplies;at least10litres bottled water/person/3days;not assessed as sufficient for actual people,climate,animals or longer isolation."
    },
    {
      "topic": "Animals",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/emergency-planning/animals",
      "facts": "Separate pets,horses,livestock;early planning;identification and appropriate transport;reliable feed/water;no moving after unsafe travel or releasing onto public roads."
    },
    {
      "topic": "Warning versus forecast",
      "source": "https://securent.nt.gov.au/prepare-for-an-emergency/bushfires",
      "method": "Official page read through web tool;raw acquisition403 on final fetch;not claimed as raw receipt.",
      "facts": "Incident warnings concern action during an incident;fire danger forecasts concern potential fire danger. Current sources are online,not supplied by offline Lastbook."
    }
